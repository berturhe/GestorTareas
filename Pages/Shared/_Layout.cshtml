<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestor de Tareas</title>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestorTareas.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar-simple">
            <div class="container-nav">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Gestor de Tareas Colaborativo</a>
            </div>
        </nav>
    </header>
    <div class="container-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="footer-simple">
        <div class="container-footer">
            &copy; 2026 - Gestor de Tareas - Reto Técnico
        </div>
    </footer>

   <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>